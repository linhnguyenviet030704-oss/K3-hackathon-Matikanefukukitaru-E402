# ── OpenRouter ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
CHAT_MODEL=openai/gpt-4.1
VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
OPENROUTER_SITE_URL=https://your-app.com
OPENROUTER_APP_NAME=AI-Dermatology-Assistant

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1
EMBEDDING_DEVICE=cpu

# ── Knowledge Base ───────────────────────────────────────────────────────────
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
VECTORSTORE_DIR=data/vectorstore/chroma_db
COLLECTION_NAME=skin_disease_kb

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ────────────────────────────────────────────────────────────────
TOP_K=5
RETRIEVAL_MODE=similarity
